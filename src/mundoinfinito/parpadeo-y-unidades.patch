diff -ruN orig/MindustryOpenWorldTest-main/src/mundoinfinito/Rescate.java mow/MindustryOpenWorldTest-main/src/mundoinfinito/Rescate.java
--- orig/MindustryOpenWorldTest-main/src/mundoinfinito/Rescate.java	1970-01-01 00:00:00.000000000 +0000
+++ mow/MindustryOpenWorldTest-main/src/mundoinfinito/Rescate.java	2026-10-15 05:35:07.840383544 +0000
@@ -0,0 +1,66 @@
+package mundoinfinito;
+
+import arc.util.Log;
+import mindustry.Vars;
+import mindustry.entities.EntityCollisions;
+import mindustry.gen.Groups;
+import mindustry.gen.Unit;
+import mindustry.type.UnitType;
+import mindustry.world.Tile;
+import mundoinfinito.MundoInfinitoMod.Streamer;
+
+/**
+ * RED DE SEGURIDAD CONTRA CASILLAS SÓLIDAS. El mod escribe terreno (muros), edificios restaurados y estructuras con
+ * Tile.setBlock sobre casillas donde puede haber unidades vivas; el motor mata a toda unidad que queda dentro de una casilla
+ * sólida para ella (UnitComp.update). Aquí, ANTES de que el motor lo haga (Trigger.update corre antes de Groups.update), se
+ * detecta y se saca a la unidad a la casilla libre más cercana. Cuesta una consulta de casilla por unidad cada 2 ticks.
+ */
+final class Rescate{
+    private static int reloj;
+    private Rescate(){}
+
+    /** ¿Puede esta unidad estar en la casilla? Mismo criterio que usa el motor (EntityCollisions.SolidPred de cada tipo). */
+    static boolean apto(Unit u, Tile t){
+        if(t == null) return false;
+        if(u.type.flying || u.type.canBoost) return true;
+        EntityCollisions.SolidPred s = u.solidity();
+        return s == null || !s.solid(t.x, t.y);
+    }
+
+    /** Casilla libre más cercana a (tx, ty) en anillos crecientes, o null. */
+    static Tile libre(Unit u, int tx, int ty, int maxRadio){
+        for(int r = 1; r <= maxRadio; r++){
+            Tile mejor = null;
+            float md = Float.MAX_VALUE;
+            for(int dy = -r; dy <= r; dy++){
+                for(int dx = -r; dx <= r; dx++){
+                    if(Math.max(Math.abs(dx), Math.abs(dy)) != r) continue;
+                    Tile c = Vars.world.tile(tx + dx, ty + dy);
+                    if(c == null || !apto(u, c)) continue;
+                    float d = dx * dx + dy * dy;
+                    if(d < md){ md = d; mejor = c; }
+                }
+            }
+            if(mejor != null) return mejor;
+        }
+        return null;
+    }
+
+    static void tick(){
+        if(!Streamer.activo || Vars.state == null || !Vars.state.isPlaying()) return;
+        if((++reloj & 1) != 0) return;
+        for(Unit u : Groups.unit){
+            if(u == null || u.dead || u.type == null || u.isPlayer() || u.type.flying || u.type.canBoost) continue;
+            try{
+                Tile t = u.tileOn();
+                if(t == null || apto(u, t)) continue;
+                Tile l = libre(u, t.x, t.y, 12);
+                if(l == null) continue;          // sin hueco cerca: se deja al motor (o a Entidades) decidir
+                u.set(l.worldx(), l.worldy());
+                u.vel.setZero();
+            }catch(Throwable e){
+                Log.warn("[MundoInfinito] Rescate falló: @", e.toString());
+            }
+        }
+    }
+}
