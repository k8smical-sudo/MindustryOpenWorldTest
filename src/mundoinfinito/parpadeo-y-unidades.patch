+package mundoinfinito;
+
+import mindustry.Vars;
+import mindustry.gen.Groups;
+import mundoinfinito.MundoInfinitoMod.Streamer;
+
+/**
+ * EFECTOS HUÉRFANOS. Tras reubicar la ventana, los chunks fuera del círculo de recarga conservan a propósito las casillas de la
+ * posición anterior (copiarChunk). Esas casillas siguen siendo suelo "real" para el juego, así que los respiraderos y demás pisos
+ * con efecto (Floor.renderUpdate) siguen emitiendo en su sitio viejo: se ven efectos donde el terreno dibujado no tiene nada.
+ * Un efecto cuya casilla está dentro de la ventana pero en un chunk SIN terreno aplicado no corresponde a nada visible: se quita.
+ * (Todo chunk cercano está aplicado; los efectos de unidades/balas viven en chunks aplicados.)
+ */
+final class Efectos{
+    private static int reloj;
+    private Efectos(){}
+
+    static void tick(){
+        if(!Streamer.activo || Streamer.meta == null || Vars.state == null || !Vars.state.isPlaying()) return;
+        if((++reloj & 3) != 0 || Streamer.nch <= 0) return;
+        if(MundoInfinitoMod.Mundos.rebase != null || MundoInfinitoMod.Mundos.viajando) return;
+        final int tam = MundoInfinitoMod.TAM_CHUNK;
+        for(int i = Groups.effect.size() - 1; i >= 0; i--){
+            var e = Groups.effect.index(i);
+            int cx = Math.floorDiv((int)(e.x / 8f), tam), cy = Math.floorDiv((int)(e.y / 8f), tam);
+            if(!Streamer.enMapa(cx, cy)) continue;                       // fuera de la ventana: no hay casillas viejas
+            if(!Streamer.generados.contains(Streamer.clave(cx, cy))) e.remove();
+        }
+    }
+}
